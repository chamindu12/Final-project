# HTTPS-only ports: admin 8080, staff 8081, guest 8082; monitoring 3000/9090.
# python3 scripts/tls-setup.py writes TLS_CERT_DIR and TLS_CERT_GID into .env.
SESSION_TTL_SECONDS=28800
# Used later by Grafana
GRAFANA_ADMIN_PASSWORD=changePassword
DOCKER_GID=999
STAFF_USERS=alice:ChangeMe-Staff1,bob:ChangeMe-Staff2
GUEST_USERS=visitor:ChangeMe-Guest1
PORTAL_SECRET_KEY=change_me_to_a_long_random_value_0123456789
ADMIN_USERS=admin:ChangeMe-Admin1
